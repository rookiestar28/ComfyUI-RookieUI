{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "web/rookieui_asset_revision.js",
    "web/rookieui_action_buttons.js",
    "web/rookieui_extension.js",
    "web/rookieui_feature_registry.js",
    "web/rookieui_host_surface.js",
    "web/rookieui_sidebar_registration.js",
    "web/sidebar_tabs/prompt_workbench/rookieui_prompt_workbench_catalog.js",
    "web/sidebar_tabs/prompt_workbench/rookieui_prompt_workbench_i18n.js",
    "web/sidebar_tabs/prompt_workbench/rookieui_prompt_workbench_tokens.js",
    "web/sidebar_tabs/rookieui_shell_persistence.js",
    "web/sidebar_tabs/rookieui_shell_state_contract.js",
    "web/sidebar_tabs/rookieui_tab_contract.js",
    "web/types/**/*.d.ts"
  ]
}
